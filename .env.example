# ---------------------------------------------------------------------------
# Ballpark Corporate Cricket League — Environment Variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must never be committed.
#
# This project has its OWN backend — do NOT reuse any Supabase, R2, Vercel,
# SMTP or email values from the previous league's project.
# ---------------------------------------------------------------------------

# Canonical production URL — used for sitemap, robots.txt, and OG/canonical tags.
# Set this in Vercel → Project → Settings → Environment Variables (Production).
# Must include https:// and NO trailing slash. e.g. https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# --- Supabase (this project's NEW, empty project) --------------------------
# Supabase Dashboard → Project Settings → API.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" API key. Safe to expose to the browser — all access is still
# governed by Row Level Security policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY — this BYPASSES Row Level Security. Never
# prefix it with NEXT_PUBLIC_ and never expose it to the browser. Used only by
# trusted server-side admin operations (see lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage (S3-compatible). SERVER-ONLY.
# Create TWO buckets in a NEW R2 account for this project:
#   * a PUBLIC bucket for player photos (public r2.dev / custom domain)
#   * a PRIVATE bucket for Aadhaar + payment screenshots (NO public access)
# The account id + API token are shared by both buckets.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# PUBLIC bucket — player photos (world-readable).
R2_PUBLIC_BUCKET=ballpark-player-photos
# Public base URL for the public bucket, e.g. https://pub-xxxx.r2.dev (no trailing slash)
R2_PUBLIC_URL=

# PRIVATE bucket — Aadhaar + payment screenshots. NO public URL; access is only
# ever via short-lived presigned URLs generated server-side for admins.
# The browser uploads directly to this bucket, so it REQUIRES a CORS policy:
#   [{ "AllowedOrigins": ["http://localhost:3000","https://YOUR-DOMAIN"],
#      "AllowedMethods": ["PUT"], "AllowedHeaders": ["content-type"],
#      "MaxAgeSeconds": 3600 }]
R2_PRIVATE_BUCKET=ballpark-player-docs

# Optional: force the PHOTO provider — "r2" or "supabase". Leave unset to
# auto-detect (R2 when the public bucket is configured, else Supabase in dev).
# PHOTO_STORAGE_PROVIDER=r2

# ---------------------------------------------------------------------------
# Email (SMTP via Gmail / Google Workspace) — SERVER-ONLY.
# Sends registration confirmation + approval/rejection emails to players.
# Requires 2-Step Verification on the account, then a Google "App Password".
# If these are unset, the app still works — it just skips sending email.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Display sender; falls back to SMTP_USER if unset. e.g. "BCCL <you@domain.com>"
EMAIL_FROM=

# Where sponsor-enquiry notification emails are sent. No default — if unset,
# enquiries are still stored in the DB but no notification email is sent.
SPONSOR_ENQUIRY_TO=
